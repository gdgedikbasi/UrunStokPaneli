@model UrunStokPaneli.Models.Product

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="form-page-header">
    <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-light form-back-button">
            ← Ürünlere Dön
    </a>  
    
   <div class="form-card product-form-card">

    <div class="form-card-header">
        <div class="form-card-icon">
            ✎
        </div>

        <div>
            <h3>Ürün Bilgileri</h3>
            <p>Ürüne ait bilgileri düzenleyebilirsiniz.</p>
        </div>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger validation-summary"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <label asp-for="ProductCode" class="form-label">
                    Ürün Kodu
                </label>

                <input asp-for="ProductCode"
                       class="form-control"
                       placeholder="Ürün kodunu girin" />

                <span asp-validation-for="ProductCode"
                      class="text-danger field-validation"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ProductName" class="form-label">
                    Ürün Adı
                </label>

                <input asp-for="ProductName"
                       class="form-control"
                       placeholder="Ürün adını girin" />

                <span asp-validation-for="ProductName"
                      class="text-danger field-validation"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="StockQuantity" class="form-label">
                    Stok Miktarı
                </label>

                <input asp-for="StockQuantity"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Stok miktarını girin" />

                <span asp-validation-for="StockQuantity"
                      class="text-danger field-validation"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Unit" class="form-label">
                    Birim
                </label>

                <input asp-for="Unit"
                       class="form-control"
                       placeholder="Örn. Adet, Kg, Litre" />

                <span asp-validation-for="Unit"
                      class="text-danger field-validation"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">
                    Kategori
                </label>

                <select asp-for="CategoryId" class="form-select">
                    <option value="">Kategori Seçiniz</option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger field-validation"></span>
            </div>

        </div>

        <div class="form-actions">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-light cancel-button">
                İptal
            </a>

            <button type="submit"
                    class="btn btn-primary save-button">
                ✓ Değişiklikleri Kaydet
            </button>

        </div>

    </form>

</div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</div>