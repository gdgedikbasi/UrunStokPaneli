@model UrunStokPaneli.Models.Product
 
@{
    ViewData["Title"] = "Ürün Sil";
}

<div class="form-page-header">
    <div>
        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-light form-back-button">
            ← Ürünlere Dön
       </a>

       <h1 class="mt-3">Ürün Silme Onayı</h1>
    </div>
</div>

<div class="form-card product-form-card">
    <div class="form-card-header">
        <div class="form-card-icon">
            !
        </div>

        <div>
            <h3>Ürünü Silmek Üzeresiniz</h3>
            <p>Silme işleminden önce ürün bilgilerini kontrol edin.</p>
        </div>
    </div>

    <div class="p-4">
        <div class="alert alert-danger">
            <strong>Dikkat!</strong>
            Bu ürünü silmek istediğinizden emin misiniz?
            Bu işlem geri alınamaz.
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Ürün Kodu</label>
                <div class="form-control bg-light">@Model.ProductCode</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Ürün Adı</label>
                <div class="form-control bg-light">@Model.ProductName</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Stok Miktarı</label>
                <div class="form-control bg-light">@Model.StockQuantity @Model.Unit</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Kategori</label>
                <div class="form-control bg-light">@Model.Category?.Name</div>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id"/>
            <div class="form-actions">
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light cancel-button">
                    İptal
               </a>
               <button type="submit" class="btn btn-danger">
                    Ürünü Sil
                </button>
            </div>
        </form>
    </div>
</div>