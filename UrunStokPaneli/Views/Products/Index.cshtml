@model List<UrunStokPaneli.Models.Product> //bu sayfa Product listesini alır.

<h1>Ürünler</h1>

<table>
    <thead>
        <tr>
            <th>Ürün Kodu</th>
            <th>Ürün Adı</th>
            <th>Stok Miktarı</th>
            <th>Birim</th>
            <th>Kategori</th>
        </tr>
    </thead>

    <tbody>
        <!-- listedeki her ürünü tek tek ekrana yazdırıyorum. -->
        @foreach(var product in Model)
        {
            <tr>
                <td>@product.ProductCode</td>
                <td>@product.ProductName</td>
                <td>@product.StockQuantity</td>
                <td>@product.Unit</td>
                <td>@product.Category.Name</td>            
            </tr>
        }
    </tbody>
</table>