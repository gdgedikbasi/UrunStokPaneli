@model List<UrunStokPaneli.Models.Product> // Bu sayfa Product listesini alır.

<h1>Ürünler</h1>

<!-- Ürün arama ve kategori filtreleme -->
<form asp-action="Index" method="get">

    <input type="text"
           name="search"
           placeholder="Ürün adı veya kodu ara..." />

    <select name="categoryId">
        <option value="">Tüm Kategoriler</option>

        @foreach (var category in ViewBag.Categories)
        {
                <option value="@category.Id">
                @category.Name
                </option>
        }
    </select>

    <button type="submit">Filtrele</button>

</form>

<br />

<table>
    <thead>
        <tr>
            <th>Ürün Kodu</th>
            <th>Ürün Adı</th>
            <th>Stok Miktarı</th>
            <th>İlk Stok Miktarı</th>
            <th>Stok Durumu</th>
            <th>Birim</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        <!-- Listedeki her ürünü tek tek ekrana yazdırıyorum. -->
        @foreach (var product in Model)
        {
                <tr>
                    <td>@product.ProductCode</td>
                    <td>@product.ProductName</td>
                    <td>@product.StockQuantity</td>
                    <td>@product.InitialStockQuantity</td>
                    <td>@product.StockStatus</td>
                    <td>@product.Unit</td>
                    <td>@product.Category.Name</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@product.Id">Düzenle</a>
                        |
                        <a asp-action="Delete" asp-route-id="@product.Id">Sil</a>
                    </td>
                </tr>
        }
    </tbody>
</table>