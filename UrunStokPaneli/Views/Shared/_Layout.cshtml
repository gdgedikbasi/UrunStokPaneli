<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UrunStokPaneli</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UrunStokPaneli.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- Sol Menü -->
    <aside class="sidebar">

        <!-- Logo -->
        <div class="sidebar-logo">
            <div class="logo-icon">
                U
            </div>

            <div>
                <div class="logo-title">UrunStok</div>
                <div class="logo-subtitle">Yönetim Paneli</div>
            </div>
        </div>


        <!-- Menü -->
        <nav class="sidebar-menu">

            <div class="menu-title">
                GENEL
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">▦</span>
                <span>Dashboard</span>

            </a>


            <div class="menu-title">
                YÖNETİM
            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">□</span>
                <span>Ürünler</span>

            </a>

            <a asp-controller="Products"
               asp-action="Import"
               class="menu-item">

                <span class="menu-icon">↑</span>
                <span>Excel Aktarımı</span>

            </a>

            <a asp-controller="Categories"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">≡</span>
                <span>Kategoriler</span>

            </a>

        </nav>


        <!-- Alt Bilgi -->
        <div class="sidebar-bottom">

            <div class="sidebar-info">
                <span class="status-dot"></span>

                <div>
                    <div class="system-title">
                        Sistem Aktif
                    </div>

                    <div class="system-subtitle">
                        Stok yönetimi
                    </div>
                </div>
            </div>

        </div>

    </aside>


    <!-- Ana Alan -->
    <div class="main-wrapper">

        <!-- Üst Bar -->
        <header class="topbar">

            <div class="topbar-left">

                <div class="page-heading">
                    @ViewData["Title"]
                </div>

            </div>


            <div class="topbar-right">

                <div class="user-info">

                    <div class="user-avatar">
                        DG
                    </div>

                    <div class="user-text">

                        <div class="user-name">
                            Yönetici
                        </div>

                        <div class="user-role">
                            Stok Yönetimi
                        </div>

                    </div>

                </div>

            </div>

        </header>


        <!-- Sayfa İçeriği -->
        <main class="content-area">

            @RenderBody()

        </main>

    </div>


    <!-- Javascript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>