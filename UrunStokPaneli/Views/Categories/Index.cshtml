@model List<UrunStokPaneli.Models.Category>

<h1>Kategoriler</h1>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Kategori Adı</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                </tr>
        }
    </tbody>
</table>