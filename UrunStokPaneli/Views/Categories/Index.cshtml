@model List<UrunStokPaneli.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="page-header">
    <div>
        <h1>Kategoriler</h1>
        <p>Ürün kategorilerini görüntüleyin ve yönetin.</p>
    </div>

    <div class="page-header-actions">
        <a asp-controller="Categories"
           asp-action="Create"
           class="btn btn-primary">
        + Yeni Kategori Ekle
       </a>
    </div>
</div>

<div class="products-table-card">
    <div class="products-table-header">
        <div>
            <h5>Kategori Listesi</h5>
            <p>Sistemde kayıtlı kategoriler</p>
        </div>

        <span class="category-badge">
            Toplam: @Model.Count kategori
        </span>
    </div>

    <div class="table-responsive">
        <table class="table products-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Kategori Adı</th>
                </tr>
            </thead>

            <tbody>
                @if(Model.Any())
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <span class="product-code-badge">
                                    #@category.Id
                                </span>
                            </td>
                            <td>
                                <span class="table-product-name">
                                    @category.Name
                                </span>
                            </td>
                        </tr>    
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center py-5">
                            Henüz kayıtlı kategori bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>